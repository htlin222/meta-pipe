# Harness configuration. Everything that was hardcoded in v1 lives here.
# Sourced by preflight.sh, run_pipeline.sh and reset.sh.

# The Claude Code pane being driven (herdr pane id). `herdr pane list` to find it.
WORKER_PANE="w7:p1A"

# The meta-analysis project under projects/.
PROJECT="neo-her2-ebc"

# Session ids that orchestrate rather than work. The Stop hook skips these so
# the driver and worker cannot wake each other in a loop.
DRIVER_SESSIONS="29c09844-0ff4-4074-a861-217431bc3bfa"

# Poll interval, seconds, while waiting on the worker.
POLL_SECONDS=10

# How long a settled state must hold before the turn counts as over.
SETTLE_POLLS=3

# How long the project tree must be unchanged before an idle agent counts as finished.
QUIET_GRACE_MIN=25
